{
  "name": "nest-boilerplate-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --config .prettierrc --check --ignore-unknown \"src/**/*.ts\"",
    "format:fix": "prettier --config .prettierrc --write --ignore-unknown \"src/**/*.ts\"",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "lint:fix": "eslint --ext .ts --fix \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "typeorm:run-migrations": "npm run typeorm migration:run -- -d ./dist/typeorm.config.js",
    "typeorm:generate-migration": "npm run typeorm -- -d ./dist/typeorm.config.js migration:generate ./src/module/database/migrations",
    "typeorm:create-migration": "npm run typeorm -- migration:create ./src/module/database/migrations",
    "typeorm:revert-migration": "npm run typeorm -- -d ./dist/typeorm.config.js migration:revert",
    "migration:create": "npm run typeorm -- migration:create ./src/module/database/migrations/$npm_config_name",
    "migration:generate": "npm run typeorm -- -d ./src/module/database/data-source.ts migration:generate ./src/module/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- -d ./src/module/database/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- -d ./src/module/database/data-source.ts migration:revert",
    "migration:show": "npm run typeorm -- -d ./src/module/database/data-source.ts migration:show",
    "schema:drop": "npm run typeorm -- -d ./src/module/database/data-source.ts schema:drop",
    "schema:sync": "npm run typeorm -- -d ./src/module/database/data-source.ts schema:sync",
    "seed:run": "ts-node -r tsconfig-paths/register ./src/module/database/seeds/run-seed.ts",
    "db": "pnpm run schema:drop && pnpm run migration:run && pnpm run seed:run",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@keyv/redis": "^5.1.6",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "argon2": "^0.45.1",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "globals": "^17.13.0",
    "hbs": "^4.3.1",
    "helmet": "^8.3.0",
    "hygen": "^6.2.11",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "keyv": "^5.6.0",
    "libphonenumber-js": "^1.13.14",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "nestjs-cls": "^7.0.1",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "env-cmd": "^11.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "webpack": "5.111.1"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverage": false,
    "collectCoverageFrom": [
      "**/*.(service|handler).(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "mocks"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@module/(.*)$": "<rootDir>/module/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@apis/(.*)$": "<rootDir>/apis/$1",
      "^packageJson$": "<rootDir>/../package.json"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/dist/"
    ],
    "maxWorkers": 1,
    "detectOpenHandles": true
  },
  "packageManager": "pnpm@10.4.0",
  "pnpm": {
    "overrides": {
      "webpack": "5.111.1"
    }
  }
}
